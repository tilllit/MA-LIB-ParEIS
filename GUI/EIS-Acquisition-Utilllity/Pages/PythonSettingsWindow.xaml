<Window x:Class="EIS_Acquisition_Utilllity.Pages.PythonSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EIS_Acquisition_Utilllity.Pages"
        mc:Ignorable="d"
        Closing="Window_Closing"
        Title="Python Settings" Height="450" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <DockPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
            <Button Content="Clear" Height="25" Width="50" Click="Clear_Button_Click" />
        </DockPanel>

        <GroupBox Header="Info" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Name="Installation_Btn" Content="Get Install" Height="25" Width="70" Margin="5" Click="Installation_Btn_Click" />
                    <Label Content="Installation: "  VerticalAlignment="Center"/>
                    <Label Name="Install_LB" Content="-" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Name="Version_Btn" Content="Get Version" Height="25" Width="70" Margin="5" Click="Version_Btn_Click" />
                    <Label Content="Version: "  VerticalAlignment="Center"/>
                    <Label Name="Version_LB" Content="-" VerticalAlignment="Center" />
                </StackPanel>
                <Button Name="Requ_Btn" Content="Install Requirements" Height="25" Width="130" Margin="5" Click="Requ_Btn_Click" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Console" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5">
            <ListBox Name="Console_LB"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
        </GroupBox>

    </Grid>
</Window>
