<Page x:Class="EIS_Acquisition_Utilllity.Pages.ParEIS_MSX.ParEIS_Manual_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EIS_Acquisition_Utilllity.Pages.ParEIS_MSX"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ParEIS_Manual_Page">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="0" Margin="10" >

                <Label Content="E-Load" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Margin="0,10,0,20" Foreground="#314973" />

                <GroupBox Header="E-Load" Margin="10">
                    <StackPanel Margin="5">

                        <Button Name="ELoad_Win_Btn" Height="35" Width="190" Content="Open E-Load Window" Margin="0,0,0,0" HorizontalAlignment="Center" Click="ELoad_Win_Btn_Click" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                            <Button Name="Start_ELoad_Btn" Height="25" Width="90" Content="Start" Margin="0,0,0,0" HorizontalAlignment="Center" Click="Start_ELoad_Btn_Click" />
                            <Button Name="Stop_ELoad_Btn" Height="25" Width="90" Content="Stop" Margin="10,0,0,0" HorizontalAlignment="Center" Click="Stop_ELoad_Btn_Click" />
                        </StackPanel>

                    </StackPanel>
                </GroupBox>
                
            </StackPanel>




            <StackPanel Grid.Column="1" Margin="10" >

                <Label Content="Acquisition - ZYNQ" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Margin="0,10,0,20" Foreground="#314973" />

                <GroupBox Header="Manual - Config." Margin="10" >
                    <StackPanel Margin="5">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Label Content="Nr. Samples: " Width="100" HorizontalContentAlignment="Right" />
                            <TextBox Name="TB_NrSamples" Width="45" Text="1000" Height="20" HorizontalContentAlignment="Right" />
                            <Label Content="Nr. M-Cards: " Width="100" HorizontalContentAlignment="Right" />
                            <TextBox Name="TB_NrCards" Width="55" Text="26" Height="20" HorizontalContentAlignment="Right" IsEnabled="False" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Label Content="Sample Freq: " Width="100" HorizontalContentAlignment="Right" />
                            <TextBox Name="TB_Fsample" Width="45" Text="200" Height="20" HorizontalContentAlignment="Right" />
                            <Label Content="Serial Freq: " Width="100" HorizontalContentAlignment="Right" />
                            <TextBox Name="TB_Fserial" Width="55" Text="25000000" Height="20" HorizontalContentAlignment="Right" IsEnabled="False" />
                        </StackPanel>

                        <Button Name="LockUnlock_Btn" Height="25" Width="70" Content="Unlock" Margin="0,5,10,0" HorizontalAlignment="Right" Click="LockUnlock_Btn_Click" />

                    </StackPanel>
                </GroupBox>



                <GroupBox Header="Functions" Margin="10" >
                    <StackPanel Margin="5">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                            <Button Name="ACC_Setup_Btn" Width="90" Height="25" Content="Setup" Click="ACC_Setup_Btn_Click" Margin="0,0,10,0" />
                            <Button Name="Start_Btn" Width="90" Height="25" Content="START" Click="Start_Btn_Click" Margin="0,0,0,0" />
                        </StackPanel>

                    </StackPanel>
                </GroupBox>

                <StackPanel HorizontalAlignment="Center" Margin="10">
                    <Button Name="ShowRAW_Plot_Btn" Height="25" Width="90" Content="Show RAW" Click="ShowRAW_Plot_Btn_Click" />
                </StackPanel>

            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>
