<Window x:Class="EIS_Acquisition_Utilllity.Pages.TestBench.TB_PHY_Values_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EIS_Acquisition_Utilllity.Pages.TestBench"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Closing="Window_Closing"
        Title="PHY - Values" Height="450" Width="800">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="1*" Name="R1" />
            <RowDefinition Height="1*" Name="R2" />
            <RowDefinition Height="1*" Name="R3" />
            <RowDefinition Height="1*" Name="R4" />
            <RowDefinition Height="1*" Name="R5" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
            <Button Name="Single_Btn" Content="Single" Height="25" Width="70" Click="Single_Btn_Click" IsEnabled="False" />
            <Button Name="ALL_Btn" Content="Combined" Height="25" Width="70" Click="ALL_Btn_Click" Margin="10,0,0,0" />
            <Button Name="Current_Btn" Content="Current" Height="25" Width="70" Click="Current_Btn_Click" Margin="10,0,0,0" />
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="0,0,10,0">
            <Button Name="Size_Btn" Content="Size" Height="25" Width="70" Click="Size_Btn_Click" />
            <Button Name="Scale_Btn" Content="Re-Scale" Height="25" Width="70" Click="Scale_Btn_Click" Margin="10,0,0,0" />
        </StackPanel>

        <ScottPlot:WpfPlot Name="Plot1_1"  Grid.Row="1" Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
        <ScottPlot:WpfPlot Name="Plot1_2"  Grid.Row="1" Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
        <ScottPlot:WpfPlot Name="Plot1_3"  Grid.Row="1" Grid.Column="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />

        <ScottPlot:WpfPlot Name="Plot2_1"  Grid.Row="2" Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
        <ScottPlot:WpfPlot Name="Plot2_2"  Grid.Row="2" Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
        <ScottPlot:WpfPlot Name="Plot2_3"  Grid.Row="2" Grid.Column="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />

        <ScottPlot:WpfPlot Name="Plot3_1"  Grid.Row="3" Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
        <ScottPlot:WpfPlot Name="Plot3_2"  Grid.Row="3" Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
        <ScottPlot:WpfPlot Name="Plot3_3"  Grid.Row="3" Grid.Column="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />

        <ScottPlot:WpfPlot Name="Plot_ALL"  Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />

        <ScottPlot:WpfPlot Name="Plot_Current"  Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />

    </Grid>



</Window>
