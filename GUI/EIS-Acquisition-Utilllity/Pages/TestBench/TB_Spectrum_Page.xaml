<Page x:Class="EIS_Acquisition_Utilllity.Pages.TestBench.TB_Spectrum_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EIS_Acquisition_Utilllity.Pages.TestBench"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TB_Spectrum_Page">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>


        <!--<GroupBox Header="Configurations" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10" Grid.Column="0">
            <ListView Name="LV_Configs" SelectionMode="Single" >
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Foreground="Black"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox>-->

        <GroupBox Header="Configurations" Margin="10">
            <ListBox Name="LB_Fequencys" Grid.Row="0" HorizontalContentAlignment="Stretch" SelectionMode="Extended" VerticalAlignment="Stretch" MinHeight="100">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2" Height="13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Height="20" VerticalAlignment="Center" />
                            <!--<ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Height="12" Width="60" VerticalAlignment="Center" Value="{Binding Completion}" Opacity="{Binding Transparent}" />-->
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>


        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">

            <GroupBox Header="Controls" Margin="10">
                <StackPanel>
                    <Button Name="RunSweep_Btn" Content="RUN Sweeps" Height="25" Width="190" Click="RunSweep_Btn_Click" Margin="5" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5">
                        <Button Name="Run_Btn" Content="RUN Single" Height="25" Width="90" Click="Run_Btn_Click" Margin="5" />
                        <Button Name="Stop_Btn" Content="Stop" Height="25" Width="90" Click="Stop_Btn_Click" Margin="5" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="DATA" Margin="10" >
                <StackPanel Margin="5">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                        <Button Name="ShowPlot_Btn" Width="70" Height="25" Content="Show Plot" Click="ShowPlot_Btn_Click" Margin="0,0,10,0" />
                        <Button Name="HidePlot_Btn" Width="70" Height="25" Content="Hide Plot" Click="HidePlot_Btn_Click" Margin="0,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Name="RAW_Write_Btn" Width="70" Height="25" Content="Write RAW" Click="RAW_Write_Btn_Click" Margin="0,0,10,0" />
                        <Button Name="RAW_Read_Btn" Width="70" Height="25" Content="Read RAW" Click="RAW_Read_Btn_Click" Margin="0,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Name="PHY_Write_Btn" Width="70" Height="25" Content="Write PHY" Click="PHY_Write_Btn_Click" Margin="0,0,10,0" />
                        <Button Name="PHY_Read_Btn" Width="70" Height="25" Content="Read PHY" Click="PHY_Read_Btn_Click" IsEnabled="true" Margin="0,0,0,0" />
                    </StackPanel>

                </StackPanel>
            </GroupBox>

            <GroupBox Header="Nyquist" Margin="10" >
                <StackPanel Margin="5">
                    <Button Name="Nyqu_New_Btn" Width="120" Height="25" Content="New Nyquist" Click="Nyqu_New_Btn_Click" Margin="0,0,0,0" />
                    <Button Name="Nyqu_Load_Btn" Width="120" Height="25" Content="Load Nyquist" Click="Nyqu_Load_Btn_Click" Margin="0,10,0,0" />
                    <Button Name="Nyqu_Process_Btn" Width="120" Height="25" Content="Proess + Add" Click="Nyqu_Process_Btn_Click" Margin="0,15,0,0" />
                    <Button Name="Nyqu_Plot_Btn" Width="120" Height="25" Content="Plot Nyquist" Click="Nyqu_Plot_Btn_Click" Margin="0,10,0,0" />
                </StackPanel>
            </GroupBox>

        </StackPanel>


    </Grid>
</Page>
