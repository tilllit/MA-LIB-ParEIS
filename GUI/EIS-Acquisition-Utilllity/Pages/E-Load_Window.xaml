<Window x:Class="EIS_Acquisition_Utilllity.Pages.E_Load_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EIS_Acquisition_Utilllity.Pages"
        mc:Ignorable="d"
        Closing="Window_Closing"
        Title="E-Load configuration" Height="500" Width="800">
    <Grid>


        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
                <Label Content="E-Load:" />
                <RadioButton Name="RB_ALL" GroupName="RB_Load" VerticalAlignment="Center" Margin="5,0,5,0" IsChecked="True" >ALL</RadioButton>
                <RadioButton Name="RB_220nF" GroupName="RB_Load" VerticalAlignment="Center" Margin="5,0,5,0" >Slow (220nF)</RadioButton>
                <RadioButton Name="RB_10nF" GroupName="RB_Load" VerticalAlignment="Center" Margin="5,0,5,0" >Fast (10nF)</RadioButton>
                <RadioButton Name="RB_2nF" GroupName="RB_Load" VerticalAlignment="Center" Margin="5,0,5,0" >Very Fast (2nF)</RadioButton>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <GroupBox Header="Config SIN" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <StackPanel>
                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,20,20,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35" MinHeight="30" />
                                <RowDefinition Height="15" />
                                <RowDefinition Height="35" MinHeight="30" />
                                <RowDefinition Height="35" MinHeight="30" />
                                <RowDefinition Height="15"  />
                                <RowDefinition Height="35" MinHeight="30" />
                                <RowDefinition Height="35" MinHeight="30" />
                                <RowDefinition Height="35" MinHeight="30" />
                                <RowDefinition Height="35" MinHeight="30" />
                                <RowDefinition Height="35" MinHeight="30" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Name="DD_LookUp" Grid.Row="9" Grid.Column="1" Width="80" Height="25" IsEditable="False" />



                            <Label Content="Frequency [Hz]:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0" />
                            <Label Content="DAC PSC:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="0" />
                            <Label Content="DAC ARR:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="3" Grid.Column="0"/>
                            <Label Content="DAC Amplitude:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="5" Grid.Column="0"/>
                            <Label Content="DAC Offset:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="6" Grid.Column="0"/>
                            <Label Content="Periods:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="7" Grid.Column="0"/>
                            <Label Content="F. Sys:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="8" Grid.Column="0"/>
                            <Label Content="Lookup Table:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="9" Grid.Column="0"/>

                            <TextBox Name="TB_Freq" Width="80" Height="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="1" PreviewTextInput="Text_PreviewTextInput" />
                            <TextBox Name="TB_PSC" Width="80" Height="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="1" PreviewTextInput="Text_PreviewTextInput"/>
                            <TextBox Name="TB_ARR" Width="80" Height="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Grid.Row="3" Grid.Column="1" PreviewTextInput="Text_PreviewTextInput" />
                            <TextBox Name="TB_AMP" Width="80" Height="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Grid.Row="5" Grid.Column="1" PreviewTextInput="Text_PreviewTextInput"/>
                            <TextBox Name="TB_OFF" Width="80" Height="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Grid.Row="6" Grid.Column="1" PreviewTextInput="Text_PreviewTextInput"/>
                            <TextBox Name="TB_PER" Width="80" Height="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Grid.Row="7" Grid.Column="1" PreviewTextInput="Text_PreviewTextInput"/>
                            <TextBox Name="TB_FSYS" Width="80" Height="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Grid.Row="8" Grid.Column="1" Foreground="Gray" IsReadOnly="True" IsHitTestVisible="False" PreviewTextInput="Text_PreviewTextInput"/>

                            <Button Name="F2C_Btn" Content="Set" Width="50" Height="25" Click="F2C_Btn_Click" Grid.Row="0" Grid.Column="2" />
                            <Button Name="C2F_Btn" Content="Set" Width="50" Height="25" Click="C2F_Btn_Click" Grid.Row="2" Grid.Column="2" Grid.RowSpan="2" />
                            <Button Name="FSYS_Ulock_Btn" Content="Unlock" Width="50" Height="25" Click="FSYS_Ulock_Btn_Click" Grid.Row="8" Grid.Column="2" />

                        </Grid>
                        <Button Name="Send_Sine_Btn" Content="Setup" Width="50" Height="25" Click="Send_Sine_Btn_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Config PULSE" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <StackPanel>
                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,20,20,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35" MinHeight="30" />
                                <RowDefinition Height="15" />
                                <RowDefinition Height="35" MinHeight="30" />
                                <RowDefinition Height="35" MinHeight="30" />
                                <RowDefinition Height="15"  />
                                <RowDefinition Height="35" MinHeight="30" />
                                <RowDefinition Height="35" MinHeight="30" />
                                <RowDefinition Height="35" MinHeight="30" />
                                <RowDefinition Height="35" MinHeight="30" />
                                <RowDefinition Height="35" MinHeight="30" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>

                            <Label Content="Pulse [s]:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0" />
                            <Label Content="DAC PSC:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="0" />
                            <Label Content="DAC ARR:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="3" Grid.Column="0"/>
                            <Label Content="DAC Offset:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="5" Grid.Column="0"/>
                            <Label Content="F. Sys:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="8" Grid.Column="0"/>

                            <TextBox Name="TB_Freq2" Width="80" Height="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="1" PreviewTextInput="Text_PreviewTextInput" />
                            <TextBox Name="TB_PSC2" Width="80" Height="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="1" PreviewTextInput="Text_PreviewTextInput"/>
                            <TextBox Name="TB_ARR2" Width="80" Height="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Grid.Row="3" Grid.Column="1" PreviewTextInput="Text_PreviewTextInput" />
                            <TextBox Name="TB_OFF2" Width="80" Height="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Grid.Row="5" Grid.Column="1" PreviewTextInput="Text_PreviewTextInput"/>
                            <TextBox Name="TB_FSYS2" Width="80" Height="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Grid.Row="8" Grid.Column="1" Foreground="Gray" IsReadOnly="True" IsHitTestVisible="False" PreviewTextInput="Text_PreviewTextInput"/>

                            <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
                                <Label VerticalAlignment="Center" Content="Offset interpretation:" />
                                <RadioButton Name="RB_A" GroupName="Offset" VerticalAlignment="Center" Margin="5" IsEnabled="False">[A]</RadioButton>
                                <RadioButton Name="RB_DAC" GroupName="Offset" VerticalAlignment="Center" IsChecked="True">DAC Counts</RadioButton>

                            </StackPanel>

                            <Button Name="F2C_Btn2" Content="Set" Width="50" Height="25" Click="F2C_Btn2_Click" Grid.Row="0" Grid.Column="2" />
                            <Button Name="C2F_Btn2" Content="Set" Width="50" Height="25" Click="C2F_Btn2_Click" Grid.Row="2" Grid.Column="2" Grid.RowSpan="2" />
                            <Button Name="FSYS_Ulock_Btn2" Content="Unlock" Width="50" Height="25" Click="FSYS_Ulock_Btn2_Click" Grid.Row="8" Grid.Column="2" />

                        </Grid>
                        <Button Name="Send_Pulse_Btn" Content="Setup" Width="50" Height="25" Click="Send_Pulse_Btn_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5" />
                    </StackPanel>
                </GroupBox>

            </StackPanel>

        </StackPanel>

    </Grid>
</Window>
