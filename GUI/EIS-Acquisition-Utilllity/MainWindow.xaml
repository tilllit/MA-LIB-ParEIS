<Window x:Class="EIS_Acquisition_Utilllity.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EIS_Acquisition_Utilllity"
        mc:Ignorable="d"
        Closing="Window_Closing"
        Title="EIS-Acquisition-Utilllity" Height="550" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>


        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Name="Connect_Btn" Height="30" Width="90" Content="Connect" Margin="5" Click="Connect_Btn_Click" IsEnabled="False" />

            <GroupBox Header="Test Bench" Margin="0,10,0,10">
                <StackPanel Margin="5">
                    <Button Name="TB_Conig_Btn" Height="30" Width="90" Content="Manual" Margin="5" Click="TB_Conig_Btn_Click" />
                    <Button Name="TB_Spectrum_Btn" Height="30" Width="90" Content="Spectrum" Margin="5,5,5,5" Click="TB_Spectrum_Btn_Click" />
                    <Button Name="TB_Calibration_Btn" Height="30" Width="90" Content="Calibration" Margin="5,5,5,5" Click="TB_Calibration_Btn_Click" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="ParEIS Model S/X" Margin="0,10,0,10">
                <StackPanel Margin="5">
                    <Button Name="MSX_Conig_Btn" Height="30" Width="90" Content="Manual" Margin="5" Click="MSX_Conig_Btn_Click" />
                    <Button Name="MSX_Spectrum_Btn" Height="30" Width="90" Content="Spectrum" Margin="5,5,5,5" Click="MSX_Spectrum_Btn_Click" />
                    <Button Name="MSX_Calibration_Btn" Height="30" Width="90" Content="Calibration" Margin="5,5,5,5" Click="MSX_Calibration_Btn_Click" />
                </StackPanel>
            </GroupBox>

        </StackPanel>


        <Frame Name="Main_Frame" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" NavigationUIVisibility="Hidden"/>

        <DockPanel VerticalAlignment="Bottom" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1">
            <StatusBar Height="25">
                <!--<Grid Margin="10,-3,10,-3" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>-->


                <StatusBarItem HorizontalAlignment="Left" Margin="0,-3,10,-3">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Connection:" Margin="10,0,0,0"  />
                        <Label Name="LB_Connecion_Status" Content="Unconnected" Margin="0,0,20,0" Width="90" FontWeight="Bold" />

                        <Label Content="Calibration:" Margin="10,0,0,0"  />
                        <Label Name="LB_Calibration_Status" Content="No Calibration!" Margin="0,0,0,0" Width="95" FontWeight="Bold" />
                    </StackPanel>
                </StatusBarItem>

                <Separator Visibility="Hidden" Width="100"/>


                <StatusBarItem HorizontalAlignment="Right" Margin="10,-3,10,-3">
                    <Label Name="LB_Status" Content="Idle" HorizontalAlignment="Right" />
                </StatusBarItem>

                

                <!--<DockPanel HorizontalAlignment="Left" Margin="10,-3,10,-3">
                    <StatusBarItem HorizontalAlignment="Left">
                    <Label Name="LB_Status2" Content="Idle" Margin="10,-3,10,-3" HorizontalAlignment="Right" />
                </StatusBarItem>
                </DockPanel>-->
                <!--</Grid>-->
            </StatusBar>
        </DockPanel>

        <DockPanel Margin="10" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <Button Name="Python_Btn" Content=".py" Height="30" Width="30" FontWeight="Bold" Click="Python_Btn_Click" />
        </DockPanel>

    </Grid>
</Window>
